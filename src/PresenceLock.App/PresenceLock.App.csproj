<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The shipping agent: ONE file, PresenceLock.exe, targeting .NET Framework 4.8, which is
    part of Windows 10 (1903+) and Windows 11. No runtime to deploy, no third-party DLLs:
    the Core engine sources are compiled straight into the exe.

    Build on Windows:   dotnet build -c Release   (or MSBuild / Visual Studio 2019+)
    Output:             src/PresenceLock.App/bin/Release/net48/PresenceLock.exe
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>PresenceLock</AssemblyName>
    <RootNamespace>PresenceLock.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- AnyCPU, not 32-bit preferred: 64-bit process on 64-bit Windows, so it reads the
         64-bit registry view (where GPO writes) and gets native-size RAWINPUTHEADER. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.6.0</Version>
    <Product>PresenceLock</Product>
    <AssemblyTitle>PresenceLock presence agent</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\PresenceLock.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

</Project>
