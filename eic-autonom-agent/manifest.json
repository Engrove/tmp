{
  "manifest_version": 3,
  "name": "EIC Autonom Agent",
  "description": "Lokal Chrome Mission Control för verifierad ChatGPT-kontinuitet och valbar AI_WEB_RESEARCH med separata controller/target-roller, bounded evidens, exakt en validerad browseråtgärd per AI-svar och fail-closed recovery.",
  "version": "0.10.11",
  "minimum_chrome_version": "138",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Öppna EIC Autonom Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "incognito": "not_allowed",
  "key": ""
}
