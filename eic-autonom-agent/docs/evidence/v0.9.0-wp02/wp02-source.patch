@@ -0,0 +1,64 @@
+import {
+  CONFIG_SCHEMA,
+  RUNTIME_SCHEMA,
+  createDefaultConfig,
+  createDefaultRuntime
+} from "./contracts.mjs";
+import { deepClone, nowIso } from "./common.mjs";
+import {
+  MISSION_MODE_IDS,
+  MISSION_POLICY_PROFILES,
+  normalizeMissionStore
+} from "./mission-contract.mjs";
+import { reconcileRuntimeMissions } from "./mission-state-machine.mjs";
+
+export function migrateV8ToV9(configValue, runtimeValue, {
+  now = Date.now()
+} = {}) {
+  const defaults = createDefaultConfig();
+  const previousConfig = configValue && typeof configValue === "object"
+    ? deepClone(configValue)
+    : {};
+  const config = { ...defaults, ...previousConfig };
+  config.schema = CONFIG_SCHEMA;
+  config.version = 9;
+  config.defaultMissionModeId ||= MISSION_MODE_IDS.CHATGPT_CONTINUATION;
+  config.missionPolicyProfile ||= MISSION_POLICY_PROFILES.STANDARD_SAFE;
+  config.missionEvidenceProfile ||= "CONTINUITY_ONLY";
+  config.updatedAt = nowIso(now);
+
+  const previousRuntime = runtimeValue && typeof runtimeValue === "object"
+    ? deepClone(runtimeValue)
+    : createDefaultRuntime();
+  const runtime = {
+    ...createDefaultRuntime(),
+    ...previousRuntime,
+    schema: RUNTIME_SCHEMA,
+    version: 9,
+    windows: previousRuntime.windows && typeof previousRuntime.windows === "object"
+      ? previousRuntime.windows
+      : {},
+    missionStore: normalizeMissionStore(previousRuntime.missionStore),
+    orphanedMissions: Array.isArray(previousRuntime.orphanedMissions)
+      ? previousRuntime.orphanedMissions.slice(-128)
+      : []
+  };
+
+  for (const [windowKey, contextValue] of Object.entries(runtime.windows)) {
+    const context = contextValue && typeof contextValue === "object" ? contextValue : {};
+    context.schema = "eic.autonom.window-context.v7";
+    context.windowId = Number.isInteger(Number(context.windowId))
+      ? Number(context.windowId)
+      : Number(windowKey);
+    context.missionIds = Array.isArray(context.missionIds)
+      ? [...new Set(context.missionIds.map(String))].slice(-128)
+      : [];
+    context.activeMissionId = context.activeMissionId ? String(context.activeMissionId) : null;
+    runtime.windows[windowKey] = context;
+  }
+
+  reconcileRuntimeMissions(runtime, { now });
+  runtime.updatedAt = nowIso(now);
+
+  return { config, runtime };
+}
