+
+function spec(responseKind, allowedPayloadKeys = [], requiredPayloadKeys = []) {
+  return Object.freeze({
+    responseKind,
+    allowedPayloadKeys: Object.freeze([...allowedPayloadKeys]),
+    requiredPayloadKeys: Object.freeze([...requiredPayloadKeys])
+  });
+}
+
