+  [UI_COMMANDS.GET_SNAPSHOT]: spec(UI_RESPONSE_KINDS.SNAPSHOT),
+  [UI_COMMANDS.IMPORT]: spec(UI_RESPONSE_KINDS.SNAPSHOT, ["payload"], ["payload"]),
+  [UI_COMMANDS.LINK_ACTIVE_TAB]: spec(UI_RESPONSE_KINDS.SNAPSHOT),
