{
  "manifest_version": 3,
  "name": "EIC Autonom Agent Greenfield",
  "description": "EIC i Chat med modellkrav, lokal förbrukningsbudget, beständiga körkvitton, skydd mot dubbla utskick och tydlig driftstatus.",
  "version": "1.8.5",
  "minimum_chrome_version": "138",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "tabs",
    "scripting",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://api.elho.fi/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "EIC Autonom Agent Greenfield",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "lib/safety-policy.js",
        "lib/model-observation.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "incognito": "not_allowed",
  "version_name": "1.8.5"
}
